# The OpenAPI spec and everything generated from it (WP0.3) must always use LF, regardless of
# this machine's git/editor line-ending settings. The "npm run verify" drift check compares
# freshly generated output (always LF) against these committed files byte-for-byte, so a
# Windows checkout that silently rewrote them to CRLF would fail the check for no real reason.
api/openapi.yaml text eol=lf
backend/app/src/generated/** text eol=lf
frontend/src/api/schema.d.ts text eol=lf

# Java sources must always be LF too (WP0.5): google-java-format (Spotless) writes LF
# unconditionally, so a Windows checkout that converts them to CRLF would make every file look
# "unformatted" to spotless:check for no real reason, the same class of problem as above.
*.java text eol=lf
