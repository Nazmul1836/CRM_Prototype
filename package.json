{
  "name": "crm-prototype",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently --kill-others -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .\\mvnw.cmd -q -pl shared -am install -DskipTests && .\\mvnw.cmd -pl app spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "verify": "npm run verify:backend && npm run verify:frontend",
    "verify:backend": "cd backend && .\\mvnw.cmd verify",
    "verify:frontend": "npm --prefix frontend run verify",
    "api": "node scripts/not-implemented.js \"npm run api\" WP0.3",
    "seed": "node scripts/not-implemented.js \"npm run seed\" WP12.1",
    "e2e": "node scripts/not-implemented.js \"npm run e2e\" WP12.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
