{
  "name": "crm-prototype",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "cd backend && .\\mvnw.cmd -q -pl shared -am install -DskipTests && .\\mvnw.cmd -pl app spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:init": "node scripts/db-init.js",
    "db:start": "node scripts/db-start.js",
    "db:stop": "node scripts/db-stop.js",
    "db:reset": "node scripts/db-reset.js",
    "verify": "npm run verify:api-fresh && npm run verify:backend && npm run verify:frontend",
    "verify:api-fresh": "node scripts/check-api-fresh.js",
    "verify:backend": "cd backend && .\\mvnw.cmd verify",
    "verify:frontend": "npm --prefix frontend run verify",
    "api": "node scripts/generate-api.js",
    "seed": "node scripts/not-implemented.js \"npm run seed\" WP12.1",
    "e2e": "node scripts/not-implemented.js \"npm run e2e\" WP12.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "concurrently": "^9.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
